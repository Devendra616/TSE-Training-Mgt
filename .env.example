# Training Management System Environment Variables

# Server
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# Database - PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=training_mgt
DB_USER=postgres
DB_PASSWORD=postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=1h

# Compliance Settings
COMPLIANCE_WARNING_DAYS=30

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-email-password
SMTP_FROM=Training Management <noreply@example.com>

# File Upload Limits (in bytes)
MAX_PHOTO_SIZE=5242880
MAX_CERTIFICATE_SIZE=10485760

# Rate Limiting
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MS=600000
API_RATE_LIMIT_MAX=50
API_RATE_LIMIT_WINDOW_MS=60000
